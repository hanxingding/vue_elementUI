{
  "presets": [
    ["@babel/preset-env", {
      "modules": false,
      "targets": {
        "browsers": ["> 1%", "last 2 versions", "not ie <= 8"]
      }
    }]
  ],
  "plugins": ["@vue/babel-plugin-transform-vue-jsx", "@babel/plugin-transform-runtime", "@babel/plugin-proposal-optional-chaining"],
  "env": {
    "test": {
      "presets": ["@babel/preset-env"],
      "plugins": ["@vue/babel-plugin-transform-vue-jsx", "@babel/plugin-transform-modules-commonjs", "dynamic-import-node"]
    }
  }
}
